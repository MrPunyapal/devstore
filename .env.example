APP_NAME=DevStore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Optional: an absolute path to an existing SQLite file.
# DB_DATABASE=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

SCOUT_DRIVER=typesense
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_PATH=
# Generate your own key, then use this same key for the Typesense server.
TYPESENSE_API_KEY=
# Any registered Typesense NL model ID; Gemini is only the example provider.
# Optional Gemini setup helper: php artisan devstore:configure-nl.
TYPESENSE_NL_MODEL_ID=gemini-model
TYPESENSE_QUERY_BY=name,description,brand,category,processor
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=60
DEVSTORE_SEARCH_DEBUG=false
